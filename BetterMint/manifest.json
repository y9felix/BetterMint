{
  "manifest_version": 3,
  "name": "BetterMint",
  "short_name": "BetterMint",
  "icons": {
    "16": "img/logo-16.png",
    "48": "img/logo-48.png",
    "128": "img/logo-128.png"
  },
  "version": "2.2.7",
  "description": "High-performance chess companion and real-time analysis extension for Chess.com.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.chess.com/*"
  ],
  "content_scripts": [
    {
      "js": [
        "js/loader.js"
      ],
      "css": [
        "css/evalbar.css"
      ],
      "matches": [
        "https://*.chess.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "html/options.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "js/Mint.js"
      ],
      "matches": [
        "https://*.chess.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
